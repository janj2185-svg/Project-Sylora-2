PORT=8787
NODE_ENV=development
SYLORA_COMPANION_PORT=43179
SYLORA_COMPANION_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
# Shared bearer between companion process and main app (required for companion in production)
SYLORA_COMPANION_TOKEN=
# Opt-in HSTS when terminating TLS at nginx (production only)
SYLORA_ENABLE_HSTS=0
SYLORA_DATA_FILE=./data/sylora.json
SESSION_TTL_DAYS=30
CREATOR_GIFT_SHARE_BPS=7000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_MODEL_FAST=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_BASE_URL=
DATABASE_URL=postgresql://sylora:sylora_dev_only@127.0.0.1:5432/sylora
REDIS_URL=redis://127.0.0.1:6379
POSTGRES_PASSWORD=sylora_dev_only
SYLORA_ICE_SERVERS_JSON=
# Alternative discrete STUN/TURN configuration (used when SYLORA_ICE_SERVERS_JSON is empty)
SYLORA_STUN_URLS=
SYLORA_TURN_URL=
# Preferred production auth: 32–512 character server-only coturn REST API secret.
# Allowed characters: letters, digits, . _ ~ + / = - (hex is recommended).
# The app derives short-lived browser credentials; this value is never returned.
SYLORA_TURN_SHARED_SECRET=
SYLORA_TURN_TTL_SECONDS=3600
# Leave both empty when the TURN host directly owns its public IPv4 address.
# Behind 1:1 NAT, set both values; forward 3478 and 49160-49259 without port
# translation. The service rejects partial or malformed NAT mappings.
SYLORA_TURN_EXTERNAL_IP=
SYLORA_TURN_RELAY_IP=
# Legacy/static client credentials (use only when shared-secret mode is unavailable)
SYLORA_TURN_USERNAME=
SYLORA_TURN_CREDENTIAL=
# Optional production multistream media router. Run the Compose `streaming` profile,
# terminate RTMPS with a public certificate, and use a public creator-facing URL.
SYLORA_MEDIA_ROUTER_CONTROL_URL=http://127.0.0.1:9997
# For Docker Compose use http://mediamtx:9997; 127.0.0.1 is only for a local process.
SYLORA_MEDIA_ROUTER_CONTROL_USER=sylora-control
# Required by the `streaming` profile: 32–512 server-only characters.
SYLORA_MEDIA_ROUTER_CONTROL_PASSWORD=
SYLORA_MEDIA_ROUTER_PUBLIC_RTMP_URL=rtmp://127.0.0.1:1935
# Exactly 32 bytes as 64 hex characters or base64url. Encrypts stream keys at rest.
SYLORA_STREAM_SECRET_KEY=
# Comma-separated extra public host suffixes allowed for Enterprise / Custom RTMP.
SYLORA_STREAM_ALLOWED_HOSTS=
# Production defaults to RTMPS-only destinations. Explicit emergency compatibility opt-in.
SYLORA_STREAM_ALLOW_INSECURE_RTMP=0
# Compose media-router listener. Defaults are loopback-only development settings.
SYLORA_RTMP_BIND_ADDRESS=127.0.0.1
SYLORA_RTMP_PORT=1935
SYLORA_RTMPS_PORT=1936
SYLORA_RTMP_ENCRYPTION=no
SYLORA_RTMP_TLS_CERT_DIR=./infra/mediamtx/dev-certs
# Optional dedicated translation / embedding providers (future — not wired as live MT yet)
SYLORA_TRANSLATE_API_KEY=
SYLORA_TRANSLATE_PROVIDER=
SYLORA_EMBEDDING_PROVIDER=
SYLORA_EMBEDDING_API_KEY=
# Payment provider — production checkout blocked until configured (future)
SYLORA_PAYMENT_PROVIDER=
SYLORA_PAYMENT_SECRET_KEY=
SYLORA_PAYMENT_WEBHOOK_SECRET=
# OAuth / OIDC signing material for Developer Platform (future — never commit real keys)
SYLORA_OAUTH_ISSUER=http://localhost:8787
SYLORA_OAUTH_PRIVATE_KEY_PEM=
SYLORA_OAUTH_PUBLIC_JWKS_JSON=
