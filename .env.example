PORT=8787
SYLORA_COMPANION_PORT=43179
SYLORA_COMPANION_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
SYLORA_DATA_FILE=./data/sylora.json
SESSION_TTL_DAYS=30
CREATOR_GIFT_SHARE_BPS=7000
SYLORA_ADMIN_EMAILS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_BASE_URL=
DATABASE_URL=postgresql://sylora:sylora_dev_only@127.0.0.1:5432/sylora
REDIS_URL=redis://127.0.0.1:6379
POSTGRES_PASSWORD=sylora_dev_only

# WebRTC ICE (authenticated endpoint only; do not embed secrets in the client)
SYLORA_ICE_SERVERS_JSON=

# Translation / speech providers (optional — features fail closed or use sandbox labels)
SYLORA_TRANSLATE_API_KEY=
SYLORA_STT_API_KEY=
SYLORA_TTS_API_KEY=
SYLORA_VOICE_PRESERVE_API_KEY=
SYLORA_EMBEDDINGS_API_KEY=

# Payments (sandbox by default; production requires provider + secret + webhook adapter)
SYLORA_PAYMENT_PROVIDER=
SYLORA_PAYMENT_SECRET_KEY=
SYLORA_PAYMENT_WEBHOOK_SECRET=
