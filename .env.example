PORT=8787
NODE_ENV=development
SYLORA_COMPANION_PORT=43179
SYLORA_COMPANION_ORIGINS=http://localhost:8787,http://127.0.0.1:8787
# Shared bearer between companion process and main app (required for companion in production)
SYLORA_COMPANION_TOKEN=
# Opt-in HSTS when terminating TLS at nginx (production only)
SYLORA_ENABLE_HSTS=0
SYLORA_DATA_FILE=./data/sylora.json
SESSION_TTL_DAYS=30
CREATOR_GIFT_SHARE_BPS=7000
SYLORA_ADMIN_EMAILS=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_MODEL_FAST=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_BASE_URL=
DATABASE_URL=postgresql://sylora:sylora_dev_only@127.0.0.1:5432/sylora
REDIS_URL=redis://127.0.0.1:6379
POSTGRES_PASSWORD=sylora_dev_only
SYLORA_ICE_SERVERS_JSON=
# Optional dedicated translation / embedding providers (future — not wired as live MT yet)
SYLORA_TRANSLATE_API_KEY=
SYLORA_TRANSLATE_PROVIDER=
SYLORA_EMBEDDING_PROVIDER=
SYLORA_EMBEDDING_API_KEY=
# Payment provider — production checkout blocked until configured (future)
SYLORA_PAYMENT_PROVIDER=
SYLORA_PAYMENT_SECRET_KEY=
SYLORA_PAYMENT_WEBHOOK_SECRET=
# OAuth / OIDC signing material for Developer Platform (future — never commit real keys)
SYLORA_OAUTH_ISSUER=http://localhost:8787
SYLORA_OAUTH_PRIVATE_KEY_PEM=
SYLORA_OAUTH_PUBLIC_JWKS_JSON=
# Password reset: never claim email delivery without a mail provider.
# In test, tokens are returned in API JSON. Set ALLOW_DEV_RESET_TOKEN=1 for local UI debugging only.
ALLOW_DEV_RESET_TOKEN=0
# Google login — server-only; leave empty until configured (endpoints fail closed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# SYLORA LIVE external platforms — server-only; adapters stay AUTH_REQUIRED until set.
# Never put these in frontend or git. See docs/audit/LIVE_OWNER_ACTION_REQUIRED.md
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
YOUTUBE_REDIRECT_URI=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
